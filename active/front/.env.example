# Base URL used by the HTTP client.
# Leave "/api" in development so the Vite dev proxy forwards to Quarkus (no CORS needed).
# For a direct cross-origin call use e.g. http://localhost:9080/api (Quarkus CORS allows http://localhost:5173).
VITE_API_BASE_URL=/api

# Target of the Vite dev-server proxy (Quarkus backend)
VITE_DEV_PROXY_TARGET=http://localhost:9080
