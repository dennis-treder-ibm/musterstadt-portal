<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="BuergerportalPU" transaction-type="JTA">

        <class>com.musterstadt.model.Citizen</class>
        <class>com.musterstadt.model.Application</class>
        <class>com.musterstadt.model.ParkingPermit</class>
        <class>com.musterstadt.model.DogRegistration</class>

        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <!-- Datasource — Quarkus picks up the default datasource via JNDI fallback,
                 but we also supply the JDBC URL so Hibernate can resolve the dialect
                 at build time during static init. -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:mem:buergerportal;DB_CLOSE_DELAY=-1;MODE=MySQL" />
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver" />

            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect" />

            <!-- none: schema is managed by DataInitializer on StartupEvent -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none" />
            <property name="hibernate.hbm2ddl.auto" value="none" />
            <property name="hibernate.show_sql" value="false" />
            <property name="hibernate.format_sql" value="false" />
            <!-- Use IDENTITY generator (maps to H2 AUTO_INCREMENT) -->
            <property name="hibernate.id.new_generator_mappings" value="false" />
        </properties>

    </persistence-unit>

</persistence>
