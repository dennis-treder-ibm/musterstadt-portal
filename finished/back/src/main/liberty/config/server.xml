<?xml version="1.0" encoding="UTF-8"?>
<server description="Bürgerportal Musterstadt">

    <featureManager>
        <feature>webProfile-8.0</feature>
        <feature>jndi-1.0</feature>
        <feature>localConnector-1.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="9080"
                  httpsPort="9443" />

    <!--
        H2 is bundled inside the WAR's WEB-INF/lib.
        We reference it via a shared library pointing at the Liberty server's
        local apps staging directory (populated by liberty:run).
        The classloader on the webApplication delegates to this shared library
        so that the JPA provider (Hibernate, also in WEB-INF/lib) can load H2.
    -->
    <library id="H2Lib">
        <fileset dir="${server.config.dir}/resources/h2" includes="h2-*.jar" />
    </library>

    <dataSource id="buergerportalDS" jndiName="jdbc/buergerportal" type="javax.sql.DataSource">
        <jdbcDriver libraryRef="H2Lib" />
        <properties url="jdbc:h2:mem:buergerportal;DB_CLOSE_DELAY=-1;MODE=MySQL"
                    user="sa"
                    password="" />
    </dataSource>

    <webApplication id="buergerportal"
                    location="buergerportal.war"
                    contextRoot="/buergerportal">
        <classloader commonLibraryRef="H2Lib" />
    </webApplication>

    <logging consoleLogLevel="INFO" />

</server>
