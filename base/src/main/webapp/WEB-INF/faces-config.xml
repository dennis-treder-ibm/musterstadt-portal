<?xml version="1.0" encoding="UTF-8"?>
<faces-config xmlns="http://xmlns.jcp.org/xml/ns/javaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                  http://xmlns.jcp.org/xml/ns/javaee/web-facesconfig_2_2.xsd"
              version="2.2">

    <!-- Navigation rules — explicit outcome-based navigation (legacy pattern) -->

    <navigation-rule>
        <from-view-id>/login.xhtml</from-view-id>
        <navigation-case>
            <from-outcome>dashboard</from-outcome>
            <to-view-id>/dashboard.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>loginFailed</from-outcome>
            <to-view-id>/login.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>

    <navigation-rule>
        <from-view-id>/dashboard.xhtml</from-view-id>
        <navigation-case>
            <from-outcome>parkingPermit</from-outcome>
            <to-view-id>/parking/parkingPermit.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>addressChange</from-outcome>
            <to-view-id>/address/addressChange.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>dogRegistration</from-outcome>
            <to-view-id>/dog/dogRegistration.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>logout</from-outcome>
            <to-view-id>/login.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>

    <navigation-rule>
        <from-view-id>/parking/parkingPermit.xhtml</from-view-id>
        <navigation-case>
            <from-outcome>dashboard</from-outcome>
            <to-view-id>/dashboard.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>parkingSuccess</from-outcome>
            <to-view-id>/parking/parkingPermit.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>

    <navigation-rule>
        <from-view-id>/address/addressChange.xhtml</from-view-id>
        <navigation-case>
            <from-outcome>dashboard</from-outcome>
            <to-view-id>/dashboard.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>addressSuccess</from-outcome>
            <to-view-id>/address/addressChange.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>

    <navigation-rule>
        <from-view-id>/dog/dogRegistration.xhtml</from-view-id>
        <navigation-case>
            <from-outcome>dashboard</from-outcome>
            <to-view-id>/dashboard.xhtml</to-view-id>
        </navigation-case>
        <navigation-case>
            <from-outcome>dogSuccess</from-outcome>
            <to-view-id>/dog/dogRegistration.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>

</faces-config>
