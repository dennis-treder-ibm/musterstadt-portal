{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "cd '/Users/dennistreder-tschechlov/Documents/IBM Vault/04 Workspace/Umweltministerium-Bob-Demo/musterstadt-portal/active/back' && mvn quarkus:dev",
      "presentation": {
        "group": "fullstack",
        "panel": "dedicated",
        "reveal": "always",
        "echo": true,
        "focus": false,
        "label": "Backend (Quarkus :9080)"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Listening for.*$",
          "endsPattern": "^.*started in.*$"
        }
      }
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "cd '/Users/dennistreder-tschechlov/Documents/IBM Vault/04 Workspace/Umweltministerium-Bob-Demo/musterstadt-portal/active/front' && npm run dev",
      "presentation": {
        "group": "fullstack",
        "panel": "dedicated",
        "reveal": "always",
        "echo": true,
        "focus": true,
        "label": "Frontend (React :5173)"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*$",
          "endsPattern": "^.*Local:.*$"
        }
      },
      "dependsOn": []
    },
    {
      "label": "Launch Full Stack",
      "dependsOn": ["Start Backend", "Start Frontend"],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
